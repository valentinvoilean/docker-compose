# Copy to .env next to this compose file, or set these in Portainer → Stack → Environment variables.
# Do not commit .env to git.

# Optional image tag (default: latest)
# QBITTORRENT_VERSION=latest

QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENTING_PORT=6881

# Create the config folder first; choose the share where downloads should be stored.
QBITTORRENT_CONFIG_HOST_PATH=/share/Container/qbittorrent/config
QBITTORRENT_DOWNLOADS_HOST_PATH=/share/Downloads

# Match the numeric user and group that should own files on the NAS (SSH: id <user>).
PUID=1000
PGID=100
TZ=Europe/Bucharest
